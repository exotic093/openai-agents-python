# ─── Model provider (any ONE key is enough) ─────────────────────────────
# Jarvis picks the first configured provider in the order below.
# Override with JARVIS_PROVIDER=openai|claude|gemini.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# JARVIS_PROVIDER=openai
# JARVIS_OPENAI_MODEL=gpt-5
# JARVIS_CLAUDE_MODEL=anthropic/claude-opus-4-7
# JARVIS_GEMINI_MODEL=gemini/gemini-2.5-pro

# ─── Core knobs ───────────────────────────────────────────────
JARVIS_USER=Sir
# JARVIS_MODEL=              # Explicit override; leave blank for auto-select.
# JARVIS_VOICE_MODEL=gpt-realtime   # Voice mode always uses OpenAI Realtime.
# JARVIS_VOICE=ballad
# JARVIS_WORKSPACE=/home/you/projects
# JARVIS_ALLOW_SHELL=1
# JARVIS_DATA_DIR=/home/you/.jarvis

# ─── Integrations (any not configured are skipped silently) ──────────────
# Each integration is a separate MCP server. Fill in only the ones you use.

# Gmail — OAuth credentials JSON path (https://github.com/GongRzhe/Gmail-MCP-Server)
# GMAIL_OAUTH_PATH=/home/you/.gmail/oauth.json
# GMAIL_CREDENTIALS_PATH=/home/you/.gmail/credentials.json

# Microsoft 365 / Outlook (https://github.com/softeria/ms-365-mcp-server)
# MS365_CLIENT_ID=
# MS365_TENANT_ID=
# MS365_CLIENT_SECRET=

# Google Calendar (https://github.com/cocal/google-calendar-mcp)
# GCAL_OAUTH_PATH=/home/you/.gcal/oauth.json
# GCAL_CREDENTIALS_PATH=/home/you/.gcal/credentials.json

# Calendly — personal access token + your hosted MCP URL
# CALENDLY_API_TOKEN=
# CALENDLY_MCP_URL=https://mcp.calendly.com/

# Slack — bot token + workspace id (https://github.com/modelcontextprotocol/servers/tree/main/src/slack)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_TEAM_ID=T01234ABCDE
# SLACK_CHANNEL_IDS=C01234,C56789

# WhatsApp — session storage path (https://github.com/lharries/whatsapp-mcp)
# WHATSAPP_SESSION_PATH=/home/you/.whatsapp

# Telegram — api id/hash from my.telegram.org (https://github.com/chigwell/telegram-mcp)
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION_PATH=/home/you/.telegram.session

# Notion — internal integration secret (https://github.com/makenotion/notion-mcp-server)
# NOTION_API_TOKEN=secret_...

# TradingView — username/password for the unofficial bridge
# TRADINGVIEW_USERNAME=
# TRADINGVIEW_PASSWORD=

# MetaTrader 5 — account credentials
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=
# MT5_PATH=/path/to/terminal64.exe

# Generic broker MCP over HTTP (Alpaca, Interactive Brokers, etc.)
# BROKER_MCP_URL=
# BROKER_MCP_TOKEN=

# HubSpot CRM (https://github.com/hubspot/hubspot-mcp-server)
# HUBSPOT_ACCESS_TOKEN=

# QuickBooks Online
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_REFRESH_TOKEN=
# QUICKBOOKS_REALM_ID=
