# Copy this to .env and fill in.

# Required: your OpenAI API key.
OPENAI_API_KEY=sk-...

# Optional: how Jarvis addresses you.
JARVIS_USER=boss

# Optional: text-mode model. Defaults to gpt-5.
# JARVIS_MODEL=gpt-5

# Optional: realtime voice model + voice name.
# JARVIS_VOICE_MODEL=gpt-realtime
# JARVIS_VOICE=ballad

# Optional: workspace root (file ops + shell are scoped here).
# JARVIS_WORKSPACE=/home/you/projects

# Optional: 0 disables shell tool execution.
# JARVIS_ALLOW_SHELL=1

# Optional: where memory + sessions live.
# JARVIS_DATA_DIR=/home/you/.jarvis
